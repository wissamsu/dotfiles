exec_always autotiling
seat seat0 hide_cursor when-typing enable
client.focused          #888888  #888888  #ffffff  #888888  #888888
client.focused_inactive #444444  #444444  #cdd6f4  #444444  #444444
client.unfocused        #333333  #333333  #cdd6f4  #333333  #333333
client.urgent           #f38ba8  #f38ba8  #1e1e2e  #f38ba8  #f38ba8
seat seat0 xcursor_theme Adwaita 18
# Audio: single idempotent script starts the PipeWire stack only if it is not
# already running, so a config reload cannot spawn duplicate daemons.
exec /home/wiss/start-audio.sh
exec keyd-application-mapper -d
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

# Basic keybindings (adjust as needed)
set $mod Mod4

# Audio keys (Touch Bar control strip + keyboard F-keys)
# bindsym XF86AudioRaiseVolume exec /home/wiss/volume.sh up
# bindsym XF86AudioLowerVolume exec /home/wiss/volume.sh down
# bindsym XF86AudioMute exec /home/wiss/volume.sh mute
# bindsym XF86AudioMicMute exec /home/wiss/volume.sh micmute

exec rm -f $XDG_RUNTIME_DIR/wob.sock && mkfifo $XDG_RUNTIME_DIR/wob.sock && tail -f $XDG_RUNTIME_DIR/wob.sock | wob

bindsym XF86AudioRaiseVolume exec /home/wiss/volume.sh up
bindsym XF86AudioLowerVolume exec /home/wiss/volume.sh down
bindsym XF86AudioMute exec /home/wiss/volume.sh mute
# Keyboard backlight keys (Touch Bar control strip)
bindsym XF86KbdBrightnessUp exec sudo -n /usr/local/bin/kbd-brightness up
bindsym XF86KbdBrightnessDown exec sudo -n /usr/local/bin/kbd-brightness down

# Terminal
bindsym $mod+Return exec foot

# App launcher
bindsym $mod+d exec wofi --show drun
bindsym $mod+space exec fuzzel
bindsym $mod+Escape exec ~/.local/bin/power-menu.sh

# Kill focused window
bindsym $mod+w kill

# Reload config
bindsym $mod+Shift+r reload

# Exit sway
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -b 'Yes' 'swaymsg exit'

# Focus movement
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+l focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Screenshot region select -> clipboard (Command+K)
bindsym $mod+k exec sh -c 'grim -g "$(slurp)" - | wl-copy --type image/png'

# Move windows
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Split orientation
bindsym $mod+b exec env LIBVA_DRIVER_NAME=iHD MOZ_ENABLE_WAYLAND=1 firefox 
bindsym $mod+Shift+f exec foot -e yazi
bindsym $mod+Shift+v splitv

# Fullscreen
bindsym $mod+f fullscreen

# Layout
bindsym $mod+s layout stacking
bindsym $mod+Shift+t layout tabbed
bindsym $mod+e layout toggle split

# Browser
bindsym $mod+Shift+b exec firefox

# Resize mode
mode "resize" {
    bindsym h resize shrink width 10px
    bindsym j resize grow height 10px
    bindsym k resize shrink height 10px
    bindsym l resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Workspace navigation
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Move to workspace
bindsym $mod+Shift+1 move container to workspace number 1; workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2; workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3; workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4; workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5; workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6; workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7; workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8; workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9; workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10; workspace number 10

# Bar
bar {
    position top
    status_command /home/wiss/.config/i3status/status.sh
    separator_symbol "│"
    font pango:JetBrainsMono Nerd Font Mono, DejaVu Sans Mono 10
    colors {
        background #1e1e2e
        statusline #cdd6f4
        separator #89b4fa
        focused_workspace #89b4fa #89b4fa #1e1e2e
        active_workspace #585b70 #585b70 #1e1e2e
        inactive_workspace #1e1e2e #1e1e2e #cdd6f4
        urgent_workspace #f38ba8 #f38ba8 #1e1e2e
    }
}

# Input
input type:keyboard {
    xkb_layout us
    xkb_options caps:escape
}

# Output
output * bg /home/wiss/Downloads/background.jpg fill

# Gaps
default_border pixel 2
default_floating_border pixel 2
gaps inner 5
gaps outer 2
exec sh -c 'sleep 10; sudo -n /usr/local/bin/dgpu-off'
